    },
    "carry_to": {
      "type": "string"
    },
    "reasons": {
      "type": "array"
    },
    "carried": {
      "type": "array"
    },
    "removed": {
      "type": "array"
    },
    "left_behind": {
      "type": "array"
    },
    "warnings": {
      "type": "array"
    },
    "at": {
      "type": "string"
    }
  }
