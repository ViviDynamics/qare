#!/usr/bin/env bash
# Claim an issue before any work starts, so two agents never implement it at once.
# The claimant is VIVI_ASSIGNEE (environment, then repo.env), else the token's login.
# An issue is held by someone else when another login is assigned, or when an open
# PR by another login is linked as closing it (GitHub's own closing references). Two claims racing: the earliest assignment wins
# and the loser unassigns itself.
# After a claim (claimed or already-mine) it also puts the issue where the team looks:
# every label in VIVI_CLAIM_LABELS (comma-separated) is added and read back, and when
# VIVI_PROJECT_OWNER and VIVI_PROJECT_NUMBER are set the issue is added to that project
# board (idempotent). Board writes need the project scope; a refused one is retried with
# gh's own signed-in auth. Neither changes the claim's status or exit code: a failure is
# listed in "warnings".
# usage: claim <issue>            claim the issue
#        claim <issue> --pr <pr>  assign the PR to the same login, read back
# exit: 0 claimed|already-mine, 1 held|lost-race|closed|not-assigned (stop),
#       2 usage or config, 3 transient gh failure
set -euo pipefail
source "$(dirname "$0")/_lib.sh"
env_assignee=${VIVI_ASSIGNEE:-}
vivi_load_env; vivi_require VIVI_REPO
issue=${1:-}; pr=""
case "$issue" in ''|*[!0-9]*) vivi_die 2 "usage: claim <issue> [--pr <pr>]";; esac
shift
if [ $# -gt 0 ]; then
  [ "$1" = "--pr" ] || vivi_die 2 "unknown argument: $1"
  pr=${2:-}
  case "$pr" in ''|*[!0-9]*) vivi_die 2 "usage: claim <issue> --pr <pr>";; esac
fi
R=$VIVI_REPO

# A failed read stops the claim; a transient one keeps vivi_gh's exit 3.
fail() { [ "$1" -eq 3 ] && exit 3; vivi_die 2 "$2"; }
# A write is judged by the read-back that follows it, so only a transient failure stops here.
write() { local code=0; vivi_gh "$@" >/dev/null || code=$?; [ "$code" -eq 3 ] && exit 3; return 0; }

if [ -n "$env_assignee" ]; then login=$env_assignee; source_=environment
elif [ -n "${VIVI_ASSIGNEE:-}" ]; then login=$VIVI_ASSIGNEE; source_=repo.env
else
  login=$(vivi_gh api user --jq .login) || fail $? "VIVI_ASSIGNEE is unset and the token's login could not be read"
  source_=token
fi
[ -n "$login" ] || vivi_die 2 "no login to claim with"

extra='{}'
emit() {  # status holders_json evidence_json
  jq -nc --argjson issue "$issue" --arg login "$login" --arg src "$source_" --arg status "$1" \
    --argjson holders "$2" --argjson evidence "$3" --arg pr "$pr" --argjson extra "$extra" \
    '{schema:"CLAIM_RESULT", issue:$issue, login:$login, login_source:$src, status:$status, holders:$holders, evidence:$evidence}
     + (if $pr != "" then {pr:($pr|tonumber)} else {} end) + $extra'
}
# Labels and board item for a claimed issue. Fills $extra; never exits.
place() {
  local want got missing warnings='[]' board=skipped item="" url labels_json code
  if [ -n "${VIVI_CLAIM_LABELS:-}" ]; then
    want=$(printf '%s' "$VIVI_CLAIM_LABELS" | jq -Rc 'split(",") | map(gsub("^\\s+|\\s+$"; "")) | map(select(length > 0))')
    code=0; vivi_gh issue edit "$issue" --repo "$R" --add-label "$(printf '%s' "$want" | jq -r 'join(",")')" >/dev/null 2>&1 || code=$?
    [ "$code" -eq 0 ] || warnings=$(printf '%s' "$warnings" | jq -c --arg c "$code" '. + ["adding labels failed (gh exit \($c))"]')
    got=$(vivi_gh issue view "$issue" --repo "$R" --json labels --jq '[.labels[].name]' 2>/dev/null) || got='[]'
    printf '%s' "$got" | jq -e . >/dev/null 2>&1 || got='[]'
    missing=$(jq -nc --argjson w "$want" --argjson g "$got" '$w - $g')
    [ "$missing" = "[]" ] || warnings=$(printf '%s' "$warnings" | jq -c --argjson m "$missing" '. + ["labels missing after the read-back: \($m | join(", "))"]')
    labels_json=$(jq -nc --argjson w "$want" --argjson m "$missing" '{wanted:$w, missing:$m}')
  else
    labels_json=null
  fi
  if [ -n "${VIVI_PROJECT_OWNER:-}" ] && [ -n "${VIVI_PROJECT_NUMBER:-}" ]; then
    url="https://github.com/$R/issues/$issue"
    item=$(vivi_gh project item-add "$VIVI_PROJECT_NUMBER" --owner "$VIVI_PROJECT_OWNER" --url "$url" --format json --jq .id 2>/dev/null) \
      || item=$(env -u GH_TOKEN -u GITHUB_TOKEN gh project item-add "$VIVI_PROJECT_NUMBER" --owner "$VIVI_PROJECT_OWNER" --url "$url" --format json --jq .id 2>/dev/null) \
      || item=""
    if [ -n "$item" ]; then board=added
    else board=failed; warnings=$(printf '%s' "$warnings" | jq -c '. + ["adding the issue to the project board failed (needs the project scope)"]'); fi
  fi
  extra=$(jq -nc --argjson l "$labels_json" --arg b "$board" --arg i "$item" --argjson w "$warnings" \
    '{board:$b} + (if $l then {labels:$l} else {} end) + (if $i != "" then {board_item:$i} else {} end) + (if ($w|length) > 0 then {warnings:$w} else {} end)')
}

if [ -n "$pr" ]; then
  write api -X POST "repos/$R/issues/$pr/assignees" -f "assignees[]=$login"
  got=$(vivi_gh pr view "$pr" --repo "$R" --json assignees) || fail $? "pr view $pr failed"
  if printf '%s' "$got" | jq -e --arg l "$login" 'any(.assignees[]; .login == $l)' >/dev/null; then
    emit claimed '[]' '[]'; exit 0
  fi
  emit not-assigned '[]' "$(jq -nc --arg e "pr #$pr assignees read back without $login" '[$e]')"; exit 1
fi

view() { vivi_gh issue view "$issue" --repo "$R" --json state,assignees; }
before=$(view) || fail $? "issue view $issue failed"
if [ "$(printf '%s' "$before" | jq -r .state)" != "OPEN" ]; then
  emit closed '[]' '["issue is not open"]'; exit 1
fi

evidence=$(printf '%s' "$before" | jq -c --arg l "$login" '[.assignees[].login | select(. != $l) | "assignee:" + .]')
q='query($owner:String!,$name:String!,$number:Int!){repository(owner:$owner,name:$name){issue(number:$number){closedByPullRequestsReferences(first:100,includeClosedPrs:false){nodes{number state author{login} assignees(first:20){nodes{login}}}}}}}'
prs=$(vivi_gh api graphql -F owner="${R%%/*}" -F name="${R#*/}" -F number="$issue" -f query="$q") || fail $? "closing pull requests read failed"
pr_evidence=$(printf '%s' "$prs" | jq -c --arg l "$login" '
  [.data.repository.issue.closedByPullRequestsReferences.nodes[] | select(.state == "OPEN")
   | (.author.login // "ghost") as $by | select($by != $l and (any(.assignees.nodes[]; .login == $l) | not))
   | "pr:#\(.number) by \($by)"]')
evidence=$(jq -nc --argjson a "$evidence" --argjson b "$pr_evidence" '$a + $b')
if [ "$evidence" != "[]" ]; then
  holders=$(printf '%s' "$evidence" | jq -c '[.[] | sub("^assignee:"; "") | sub("^pr:#[0-9]+ by "; "")] | unique')
  emit held "$holders" "$evidence"; exit 1
fi

if printf '%s' "$before" | jq -e --arg l "$login" 'any(.assignees[]; .login == $l)' >/dev/null; then
  place; emit already-mine '[]' '[]'; exit 0
fi

write issue edit "$issue" --repo "$R" --add-assignee "$login"
after=$(view) || fail $? "issue view $issue failed after assigning"
assignees=$(printf '%s' "$after" | jq -c '[.assignees[].login]')
if ! printf '%s' "$assignees" | jq -e --arg l "$login" 'index($l) != null' >/dev/null; then
  emit not-assigned '[]' "$(jq -nc --arg e "issue assignees read back without $login" '[$e]')"; exit 1
fi
if [ "$(printf '%s' "$assignees" | jq 'length')" -gt 1 ]; then
  # Someone claimed in the same window. Each current assignee's latest
  # "assigned" event dates their claim; the earliest of those wins.
  events=$(vivi_gh api "repos/$R/issues/$issue/events" --paginate --jq '.[] | select(.event=="assigned") | [.id, .assignee.login] | @tsv') \
    || fail $? "issue events read failed; $issue is assigned to $(printf '%s' "$assignees" | jq -r 'join(",")')"
  winner=$(printf '%s\n' "$events" | jq -Rrn --argjson cur "$assignees" '
    [inputs | select(length > 0) | split("\t") | {id: (.[0]|tonumber), login: .[1]} | select(.login as $x | $cur | index($x))]
    | group_by(.login) | map(max_by(.id)) | min_by(.id) | .login // ""')
  if [ "$winner" != "$login" ]; then
    write issue edit "$issue" --repo "$R" --remove-assignee "$login"
    others=$(printf '%s' "$assignees" | jq -c --arg l "$login" 'map(select(. != $l))')
    evidence=$(printf '%s' "$others" | jq -c 'map("assignee:" + .)')
    note=""
    if ! left=$(view 2>/dev/null); then note="unassign not verified: the issue could not be read back"
    elif printf '%s' "$left" | jq -e --arg l "$login" 'any(.assignees[]; .login == $l)' >/dev/null; then
      note="unassign failed: issue is still assigned to $login"
    fi
    [ -z "$note" ] || evidence=$(printf '%s' "$evidence" | jq -c --arg n "$note" '. + [$n]')
    emit lost-race "$others" "$evidence"; exit 1
  fi
fi
place
emit claimed '[]' '[]'
