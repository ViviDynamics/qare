#!/usr/bin/env bash
# Token-resolving gh wrapper for the one-off reads a skill still makes directly.
# Output is whatever gh prints on stdout; exit codes are vivi_gh's.
# usage: vgh <gh args...>     exit: gh's code, or 3 after transient retries
set -euo pipefail
source "$(dirname "$0")/_lib.sh"
vivi_load_env
code=0
vivi_gh "$@" || code=$?
exit "$code"
