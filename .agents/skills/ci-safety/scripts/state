#!/usr/bin/env bash
# Per-issue JSON state for resumable skill chains, in the git common dir (vivi-state/),
# so every worktree of the clone reads and writes the same record. A record left at the
# old place, <worktree>/.agents/state/<issue>.json, is moved there on first use.
# usage: state get <issue> [key] | set <issue> <key> <value> | incr <issue> <key> | append <issue> <key> <value> | clear <issue>
set -euo pipefail
source "$(dirname "$0")/_lib.sh"
vivi_load_env
cmd=${1:-}; issue=${2:-}
[ -n "$issue" ] || vivi_die 2 "usage: state <get|set|incr|append|clear> <issue> ..."
dir=$(vivi_state_dir) || exit 2; file="$dir/$issue.json"
legacy="$VIVI_ROOT/.agents/state/$issue.json"
# Writes (and the one-time move of an old record) hold the issue's lock; reads do not
# need it, since every write replaces the file in one rename.
case "$cmd" in
  set|incr|append|clear) vivi_state_lock "$issue" || exit $?; trap vivi_state_unlock EXIT ;;
esac
if [ ! -f "$file" ] && [ -f "$legacy" ]; then
  vivi_state_lock "$issue" || exit $?; trap vivi_state_unlock EXIT
  t=$(mktemp "$file.XXXXXX") && cp "$legacy" "$t" && mv "$t" "$file" && rm -f "$legacy"
fi
# Prints the current state on stdout, or returns non-zero if the file exists
# but is not valid JSON. Never emits anything on failure so callers can rely
# on the exit code rather than parsing the output.
current() {
  if [ -f "$file" ]; then
    jq -e . "$file" >/dev/null 2>&1 || return 1
    cat "$file"
  else
    echo '{}'
  fi
}
write() { local t; t=$(mktemp "$file.XXXXXX") && printf '%s\n' "$1" > "$t" && mv "$t" "$file"; printf '%s\n' "$1"; }
now() { date -u +%Y-%m-%dT%H:%M:%SZ; }
case "$cmd" in
  get)
    cur=$(current) || vivi_die 1 "state file $file is not valid JSON"
    if [ -n "${3:-}" ]; then
      printf '%s' "$cur" | jq -rc --arg k "$3" 'if has($k) then .[$k] else empty end'
    else
      printf '%s' "$cur" | jq -c .
    fi ;;
  set)
    [ -n "${3:-}" ] && [ -n "${4+x}" ] || vivi_die 2 "usage: state set <issue> <key> <value>"
    if v=$(printf '%s' "$4" | jq -c . 2>/dev/null); then :; else v=$(printf '%s' "$4" | jq -Rs .); fi
    cur=$(current) || vivi_die 1 "state file $file is not valid JSON"
    new=$(printf '%s' "$cur" | jq -c --arg k "$3" --argjson v "$v" --arg t "$(now)" '.[$k]=$v | .updated_at=$t') || vivi_die 1 "state update failed for $file"
    write "$new" ;;
  incr)
    [ -n "${3:-}" ] || vivi_die 2 "usage: state incr <issue> <key>"
    cur=$(current) || vivi_die 1 "state file $file is not valid JSON"
    new=$(printf '%s' "$cur" | jq -c --arg k "$3" --arg t "$(now)" '.[$k]=((.[$k] // 0) + 1) | .updated_at=$t') || vivi_die 1 "state update failed for $file (is $3 numeric?)"
    write "$new" ;;
  append)
    [ -n "${3:-}" ] && [ -n "${4+x}" ] || vivi_die 2 "usage: state append <issue> <key> <value>"
    if v=$(printf '%s' "$4" | jq -c . 2>/dev/null); then :; else v=$(printf '%s' "$4" | jq -Rs .); fi
    cur=$(current) || vivi_die 1 "state file $file is not valid JSON"
    new=$(printf '%s' "$cur" | jq -c --arg k "$3" --argjson v "$v" --arg t "$(now)" '
      .[$k]=(if (has($k) and (.[$k] | type == "array")) then .[$k] else [] end)
      | .[$k]=(if (.[$k] | index($v)) != null then .[$k] else .[$k] + [$v] end)
      | .updated_at=$t') || vivi_die 1 "state update failed for $file"
    write "$new" ;;
  clear)
    rm -f "$file" "$legacy"
    # An old record in another worktree of the clone would come back on its next use.
    git worktree list --porcelain 2>/dev/null | sed -n 's/^worktree //p' | while IFS= read -r w; do
      rm -f "$w/.agents/state/$issue.json"
    done ;;
  *) vivi_die 2 "unknown command: $cmd (want get|set|incr|append|clear)" ;;
esac
