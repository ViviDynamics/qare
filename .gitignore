# Vivi skills wiring: .agents/state/ and repo.env are local; repo.env.example
# is committed so other clones can recreate repo.env.
.agents/state/
repo.env

# Exception: .agents/skills/ is the shared team workflow set — tracked on purpose.
# .claude/skills and .opencode/skill are symlinks to .agents/skills.
# (.agents/* not .agents/: git will not descend into an excluded directory to
# re-include its contents.)
.agents/*
!.agents/skills/
!.agents/test-commands.md
!.agents/flake-signatures.txt
.claude/*
!.claude/skills
.opencode/*
!.opencode/skill
qare-evidence/
benchmark-out/
