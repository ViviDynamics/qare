# Local wiring for the Vivi Dynamics workflow skills (.claude/skills/).
# Copy this file to repo.env and adjust; repo.env itself is gitignored.
# See docs/test-commands.md and docs/flake-signatures.txt for the two file-backed keys.
VIVI_REPO=ViviDynamics/qare
VIVI_DEFAULT_BRANCH=main
VIVI_MERGE_FLAGS="--squash --delete-branch"
VIVI_GH_TOKEN_FILE=$HOME/Workspaces/.gh_token
VIVI_TEST_COMMANDS_FILE=docs/test-commands.md
VIVI_FLAKE_SIGNATURES_FILE=docs/flake-signatures.txt
