# Copy to repo root as repo.env and fill in. Sourced by skill scripts.
# Only VIVI_* keys are read. $HOME is the only expansion performed.

# Required
VIVI_REPO=ViviDynamics/qare
VIVI_DEFAULT_BRANCH=main
VIVI_MERGE_FLAGS="--squash --delete-branch"

# Optional
VIVI_GH_TOKEN_FILE=
VIVI_PROJECT_OWNER=ViviDynamics
VIVI_PROJECT_NUMBER=
VIVI_BRANCH_PATTERN=feat/{issue}-{slug}
# Workflow FILE that gates PRs, e.g. ci.yml (not its display name). Empty: all runs.
VIVI_CI_WORKFLOW=ci.yml
VIVI_FLAKE_SIGNATURES_FILE=.agents/flake-signatures.txt
VIVI_TEST_COMMANDS_FILE=.agents/test-commands.md
VIVI_REVIEW_TOOL=self   # independent | harness | copilot | self
# merge-verified proves a green run tested the current main. qare's CI has no
# "Record the tested merge <sha>" step, so freshness is proven by the head containing
# main; a branch behind main is updated and its CI runs again.
VIVI_MERGE_FRESHNESS=contains
# Per person: set your own GitHub login in your local repo.env, never here.
# Empty: ship-issue claims issues as the token's own login.
VIVI_ASSIGNEE=
# Repo conventions every stage of ship-issue must follow.
VIVI_HOUSE_RULES_FILE=AGENTS.md
# disclosure-guard: this repository is public. The private term list is never committed;
# CI reads it from a secret, agents from ~/.config/vivi/disclosure-terms.
VIVI_REPO_VISIBILITY=public
